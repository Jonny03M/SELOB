<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>svRegistro</servlet-name>
        <servlet-class>com.SELOB.servlets.svRegistro</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>svInicioSesion</servlet-name>
        <servlet-class>com.SELOB.servlets.svInicioSesion</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>svMakePub</servlet-name>
        <servlet-class>com.SELOB.servlets.svMakePub</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>svProfileCustom</servlet-name>
        <servlet-class>com.SELOB.servlets.svProfileCustom</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>svGuest</servlet-name>
        <servlet-class>com.SELOB.servlets.svGuest</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>svFound</servlet-name>
        <servlet-class>com.SELOB.servlets.svFound</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>svActPub</servlet-name>
        <servlet-class>com.SELOB.servlets.svActPub</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>svDeletePub</servlet-name>
        <servlet-class>com.SELOB.servlets.svDeletePub</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>svRegistro</servlet-name>
        <url-pattern>/svRegistro</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>svInicioSesion</servlet-name>
        <url-pattern>/svInicioSesion</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>svMakePub</servlet-name>
        <url-pattern>/svMakePub</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>svProfileCustom</servlet-name>
        <url-pattern>/svProfileCustom</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>svGuest</servlet-name>
        <url-pattern>/svGuest</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>svFound</servlet-name>
        <url-pattern>/svFound</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>svActPub</servlet-name>
        <url-pattern>/svActPub</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>svDeletePub</servlet-name>
        <url-pattern>/svDeletePub</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
